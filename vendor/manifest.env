# =============================================================================
# Pinned dependency manifest — single source of truth for fetch + install.
# Edit here to bump versions; both fetch-assets.sh and install.sh read this.
# Target platform: Ubuntu 24.04 LTS (noble), amd64.
#
# AWX is deployed on a single-node k3s cluster via the AWX Operator. There is no
# single "offline installer" upstream, so we vendor three things:
#   1. k3s (binary + install script + airgap container-image tarball)
#   2. the awx-operator source (for kustomize) + its container image
#   3. the AWX runtime container images the operator will deploy
# =============================================================================

# ---- k3s (lightweight Kubernetes) ----
# Pick a release from https://github.com/k3s-io/k3s/releases . The '+k3s1' suffix
# is part of the tag; in URLs the '+' must be percent-encoded as %2B.
K3S_VERSION="v1.30.6+k3s1"
K3S_BASE_URL="https://github.com/k3s-io/k3s/releases/download/${K3S_VERSION}"
# Files fetched from K3S_BASE_URL (binary + airgap images tarball).
K3S_BINARY="k3s"                                   # the amd64 binary is named just 'k3s'
K3S_AIRGAP_IMAGES="k3s-airgap-images-amd64.tar.zst"
# k3s install script (pinned by commit-less stable URL; cached locally and run with INSTALL_K3S_SKIP_DOWNLOAD=true)
K3S_INSTALL_SCRIPT_URL="https://get.k3s.io"

# ---- AWX Operator (deployed with kustomize from the vendored source tree) ----
AWX_OPERATOR_VERSION="2.19.1"
AWX_OPERATOR_SRC_URL="https://github.com/ansible/awx-operator/archive/refs/tags/${AWX_OPERATOR_VERSION}.tar.gz"
AWX_OPERATOR_SRC_TGZ="awx-operator-${AWX_OPERATOR_VERSION}.tar.gz"

# ---- Container images (saved to vendor/images/*.tar, imported into k3s) ----
# IMPORTANT: every tag here is PINNED TO AN IMMUTABLE VERSION so the offline
# bundle is reproducible. The operator 2.19.1 defaults for redis/postgres are
# floating tags ('7', 'latest'); we resolve them to concrete tags below and
# override them in config/awx.yaml.tmpl so the operator deploys exactly what we
# vendored. If you bump AWX_OPERATOR_VERSION, re-check these against the operator
# (roles/installer/defaults/main.yml of that tag).
#
# Each image is split into NAME + VERSION so fetch-assets.sh and the AWX CR
# reference identical tags.
AWX_OPERATOR_IMAGE="quay.io/ansible/awx-operator:${AWX_OPERATOR_VERSION}"

# The operator pod runs a kube-rbac-proxy sidecar (see config/default/manager_*
# in the operator source) or the controller-manager pod gets ImagePullBackOff
# offline. The operator REFERENCES it at gcr.io/kubebuilder/... but that address
# is dead (Google shut down gcr.io and sunset the kubebuilder mirror), so we
# PULL from the maintainer's surviving registry and re-tag it to the gcr.io name
# in the saved tarball — the name containerd must resolve at runtime. The tag
# must match what the chosen operator version requests (check
# config/default/manager_auth_proxy_patch.yaml in the operator tarball).
AWX_KUBE_RBAC_PROXY_IMAGE="gcr.io/kubebuilder/kube-rbac-proxy:v0.15.0"
AWX_KUBE_RBAC_PROXY_PULL="quay.io/brancz/kube-rbac-proxy:v0.15.0"

AWX_IMAGE_NAME="quay.io/ansible/awx"
AWX_IMAGE_VERSION="24.6.1"

AWX_EE_IMAGE_NAME="quay.io/ansible/awx-ee"
AWX_EE_IMAGE_VERSION="24.6.1"

# sclorg postgres has no semver tags; '20260624' is the immutable date-stamped
# tag equivalent to 'latest' at pin time (digest sha256:ac3b40d7...).
AWX_POSTGRES_IMAGE_NAME="quay.io/sclorg/postgresql-15-c9s"
AWX_POSTGRES_IMAGE_VERSION="20260624"

# Concrete patch of the operator's default redis '7'.
AWX_REDIS_IMAGE_NAME="docker.io/redis"
AWX_REDIS_IMAGE_VERSION="7.4.9"

# Init container for projects-persistence (operator default). Upstream offers no
# date-suffixed immutable tag for 'stream9', so we PIN BY DIGEST: fetch-assets.sh
# pulls the exact manifest below and re-tags it as :stream9 in the saved tarball
# (which is the tag the operator/CR references). To repin, look up the current
# digest of quay.io/centos/centos:stream9 and update AWX_INIT_IMAGE_DIGEST.
AWX_INIT_IMAGE_NAME="quay.io/centos/centos"
AWX_INIT_IMAGE_VERSION="stream9"
AWX_INIT_IMAGE_DIGEST="sha256:5665c076f25172d372d6fb7934f49f9f99b36aa6117afd1935186ccb9fb88cb0"

# Full refs (derived) — used by the CR template and the image list.
AWX_EE_IMAGE="${AWX_EE_IMAGE_NAME}:${AWX_EE_IMAGE_VERSION}"
AWX_INIT_IMAGE="${AWX_INIT_IMAGE_NAME}:${AWX_INIT_IMAGE_VERSION}"

# Space-separated list consumed by fetch-assets.sh and the image loader.
AWX_IMAGES="
${AWX_OPERATOR_IMAGE}
${AWX_KUBE_RBAC_PROXY_IMAGE}
${AWX_IMAGE_NAME}:${AWX_IMAGE_VERSION}
${AWX_EE_IMAGE_NAME}:${AWX_EE_IMAGE_VERSION}
${AWX_POSTGRES_IMAGE_NAME}:${AWX_POSTGRES_IMAGE_VERSION}
${AWX_REDIS_IMAGE_NAME}:${AWX_REDIS_IMAGE_VERSION}
${AWX_INIT_IMAGE_NAME}:${AWX_INIT_IMAGE_VERSION}
"
