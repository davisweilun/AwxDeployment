# Copy to config.env and edit. Sourced by install.sh.
# config.env is gitignored so secrets never get committed.

# FQDN clients will use to reach AWX. For nodeport access you can also just use
# the host IP; this value is what AWX sets as its external hostname.
AWX_HOSTNAME="awx.example.com"

# Initial 'admin' password. Change in the UI after first login.
AWX_ADMIN_PASSWORD="ChangeMe-AWX-12345"

# Kubernetes namespace + AWX instance name.
AWX_NAMESPACE="awx"
AWX_NAME="awx"

# How AWX is exposed:
#   nodeport  -> reachable at http://<host>:<AWX_NODEPORT>/  (simplest, default)
#   ingress   -> requires the cluster to have an ingress controller (k3s ships Traefik)
AWX_SERVICE_TYPE="nodeport"
AWX_NODEPORT="30080"

# Ingress TLS (only used when AWX_SERVICE_TYPE=ingress). When true, the cert/key
# below are loaded into a TLS secret and referenced by the ingress.
AWX_INGRESS_TLS="false"
CERT_FILE="./certs/cert.pem"
KEY_FILE="./certs/key.pem"

# Persistent volume sizes (provisioned by k3s local-path StorageClass).
AWX_POSTGRES_STORAGE="8Gi"
AWX_PROJECTS_STORAGE="8Gi"
